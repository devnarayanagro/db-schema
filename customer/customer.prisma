// ==================================================================
// CUSTOMER ACCOUNT — shopper-facing login (phone OTP, no password)
// Fully independent of partner.prisma / admin.prisma: own identity
// fields, own OAuth table, own session table, own verification table.
// ==================================================================

model CustomerAccount {
  id BigInt @id

  phone         String    @unique // primary login method
  phoneVerified DateTime?
  email         String?   @unique // optional, e.g. for order receipts — never used with a password
  emailVerified DateTime?

  name      String?
  firstName String?
  middleName String?
  lastName  String?
  avatarUrl String?
  dob       DateTime?
  gender    String?

  sessions      CustomerSession[]
  addresses     Address[]
  recentlyViewedProducts RecentlyViewedProduct[]
  productReviews ProductReview[]
  reviewVotes ProductReviewVote[]
  wishlistItems CustomerWishlistItem[]
  cart          CustomerCart?
  checkouts     CustomerCheckout[]
  coupons      CustomerCoupon[]
  notifications CustomerNotification[]
  wallet       CustomerWallet?
  rewardAccount CustomerRewardAccount?
  supportTickets CustomerSupportTicket[]
  orders       CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductReviewStatus {
  pending
  approved
  rejected
}

model ProductReview {
  id              String             @id @default(uuid())
  // Review API payload identifies the product and sends rating, title, body, and categoryRatings.
  customerId      BigInt
  productId       String
  rating          Int
  title           String?
  body            String?            @db.Text
  images          Json               @default("[]")
  status          ProductReviewStatus @default(pending) // Public review queries require approved.
  verifiedPurchase Boolean            @default(false) // Set from purchase eligibility, never from the client.
  helpfulCount    Int                @default(0)
  notHelpfulCount Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryRatings ProductReviewCategoryRating[]
  votes ProductReviewVote[]

  @@unique([customerId, productId])
  @@index([productId, status])
  @@index([customerId])
}

enum ProductReviewRatingCategory {
  effectiveness
  value_for_money
  ease_of_application
  packaging_quality
  delivery_experience
}

model ProductReviewCategoryRating {
  id       String                       @id @default(uuid())
  reviewId String
  category ProductReviewRatingCategory
  rating   Int

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, category])
  @@index([category])
}

enum ReviewVoteType {
  helpful
  not_helpful
}

model ProductReviewVote {
  id         String        @id @default(uuid())
  customerId BigInt
  productId  String
  reviewId   String
  vote       ReviewVoteType
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  review   ProductReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([customerId, reviewId])
  @@index([productId])
  @@index([reviewId])
}

model RecentlyViewedProduct {
  id         String         @id @default(uuid())
  customerId BigInt?
  productId  String
  viewedAt   DateTime       @default(now())

  customer CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, viewedAt])
  @@index([productId])
}

// Products saved by a customer for later purchase.
model CustomerWishlistItem {
  id         String   @id @default(uuid())
  customerId BigInt
  productId  String
  createdAt  DateTime @default(now())

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

enum CouponRedemptionStatus {
  active
  used
  expired
  cancelled
}

// Coupons assigned to a customer with per-user redemption and usage tracking.
model CustomerCoupon {
  id           String                  @id @default(uuid())
  customerId   BigInt
  couponId     String?
  code         String                  @db.VarChar(64)
  description  String?
  status       CouponRedemptionStatus  @default(active)
  expiresAt    DateTime?
  redeemedAt   DateTime?
  usedAt       DateTime?
  amountSaved  Decimal?                @db.Decimal(12, 2)
  orderId      String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon   Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  order    CustomerOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([customerId, code])
  @@index([customerId, status, expiresAt])
  @@index([couponId, status])
  @@index([orderId])
}

model CustomerNotification {
  id         String    @id @default(uuid())
  customerId BigInt
  title      String
  body       String    @db.Text
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, readAt, createdAt])
}

model CustomerWallet {
  id         String   @id @default(uuid())
  customerId BigInt   @unique
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer     CustomerAccount          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions CustomerWalletTransaction[]
}

model CustomerWalletTransaction {
  id        String   @id @default(uuid())
  walletId  String
  amount    Decimal  @db.Decimal(12, 2)
  type      String   @db.VarChar(30) // credit, debit, refund, adjustment
  reference String?  @db.VarChar(120)
  note      String?
  createdAt DateTime @default(now())

  wallet CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model CustomerRewardAccount {
  id          String   @id @default(uuid())
  customerId  BigInt   @unique
  joinedAt    DateTime?
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerSupportTicket {
  id         String   @id @default(uuid())
  customerId BigInt
  subject    String   @db.VarChar(160)
  body       String   @db.Text
  status     String   @default("open") @db.VarChar(30)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, status, createdAt])
}

enum CustomerOrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
  returned
}

model CustomerOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique
  // Order pages read this record by id/orderNumber and scope it to the session customerId.
  customerId           BigInt
  checkoutId           String?             @unique
  couponId             String?
  status               CustomerOrderStatus @default(pending)
  paymentMethod        String?             @db.VarChar(40)
  paymentStatus        String              @default("pending") @db.VarChar(30)
  paymentProvider      String?             @db.VarChar(40)
  paymentTransactionId String?             @db.VarChar(160)
  paymentFailureReason String?             @db.Text
  currency             String              @default("INR") @db.VarChar(3)
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  deliveryFee          Decimal             @default(0) @db.Decimal(12, 2)
  discount             Decimal             @default(0) @db.Decimal(12, 2)
  couponCode           String?             @db.VarChar(64)
  couponDiscount       Decimal             @default(0) @db.Decimal(12, 2)
  total                Decimal             @default(0) @db.Decimal(12, 2)
  shippingAddress      Json // Snapshot captured at order creation; do not read the live address later.
  carrier              String?             @db.VarChar(80)
  trackingNumber       String?             @db.VarChar(120)
  estimatedDeliveryAt  DateTime?
  paidAt               DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?             @db.Text
  returnedAt           DateTime?
  returnReason         String?             @db.Text
  returnStatus         String?             @db.VarChar(30)
  invoiceNumber        String?             @unique @db.VarChar(80)
  invoiceUrl           String?             @db.Text
  placedAt             DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  checkout CustomerCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  coupon   Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    CustomerOrderItem[]
  couponRedemptions CustomerCoupon[]

  @@index([customerId, placedAt])
  @@index([customerId, status])
  @@index([trackingNumber])
  @@index([paymentTransactionId])
}

model CustomerOrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  // Review eligibility checks this productId against an order owned by the session customer.
  productId           String
  name                String
  brand               String?
  category            String?
  unit                String?
  imageUrl            String?
  quantity            Int
  maximumRetailPrice  Decimal? @db.Decimal(12, 2)
  unitPrice           Decimal  @db.Decimal(12, 2)
  total               Decimal  @db.Decimal(12, 2)

  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model CustomerSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  customerId   BigInt
  expires      DateTime

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Email verification / magic-link token store, scoped to customers only.
model CustomerVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Backs the phone OTP login flow for customers. Wire this up to a
// Credentials provider: request an OTP -> row created here -> verify -> sign in.
model CustomerPhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String // never store the raw OTP, hash it (e.g. bcrypt/sha256)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// A customer can save multiple shipping/billing addresses; one is marked default.
model Address {
  id         String          @id @default(uuid())
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Address form sends label, line1/line2, city, state, postalCode, phone, and isDefault.
  customerId BigInt

  label      String? // "Home", "Work", etc.
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  phone      String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}
