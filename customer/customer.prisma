// ==================================================================
// CUSTOMER ACCOUNT — shopper-facing login (phone OTP, no password)
// Fully independent of partner.prisma / admin.prisma: own identity
// fields, own OAuth table, own session table, own verification table.
// ==================================================================

model CustomerAccount {
  id BigInt @id

  phone         String    @unique // primary login method
  phoneVerified DateTime?
  email         String?   @unique // optional, e.g. for order receipts — never used with a password
  emailVerified DateTime?

  name      String?
  avatarUrl String?
  dob       DateTime?
  gender    String?

  oauthAccounts CustomerOAuthAccount[]
  sessions      CustomerSession[]
  addresses     Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// OAuth link table for customers (Google/Apple sign-in etc.), mirrors
// Auth.js's standard "Account" model shape but scoped to CustomerAccount only.
model CustomerOAuthAccount {
  id                String  @id @default(uuid())
  customerId        BigInt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model CustomerSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  customerId   BigInt
  expires      DateTime

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Email verification / magic-link token store, scoped to customers only.
model CustomerVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Backs the phone OTP login flow for customers. Wire this up to a
// Credentials provider: request an OTP -> row created here -> verify -> sign in.
model CustomerPhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String // never store the raw OTP, hash it (e.g. bcrypt/sha256)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// A customer can save multiple shipping/billing addresses; one is marked default.
model Address {
  id         String          @id @default(uuid())
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId BigInt

  label      String? // "Home", "Work", etc.
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  phone      String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}
