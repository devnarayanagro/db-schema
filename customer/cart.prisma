// The active shopping cart for a customer and its selected product packs.
model CustomerCart {
  id         String   @id @default(uuid())
  customerId BigInt   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer CustomerAccount  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CustomerCartItem[]
}

model CustomerCartItem {
  id            String   @id @default(uuid())
  cartId        String
  productId     String
  pricingTierId String
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart        CustomerCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  pricingTier PricingTier  @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)

  @@unique([cartId, pricingTierId])
  @@index([productId])
  @@index([pricingTierId])
}