enum CartPromoBannerStatus {
  enabled
  disabled
}

enum CartPromoBannerTheme {
  farm
  harvest
  field
  sky
}

// Configurable promotional slides shown above the cart contents.
model CartPromoBanner {
  id        String                @id @default(uuid())
  status    CartPromoBannerStatus @default(enabled)
  position  Int                   @default(0)
  eyebrow   String?               @db.VarChar(80)
  title     String                @db.VarChar(160)
  text      String?               @db.VarChar(500)
  linkUrl   String?               @db.VarChar(500)
  theme     CartPromoBannerTheme  @default(farm)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([position])
  @@index([status, position])
}