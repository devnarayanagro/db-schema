enum NewsletterSubscriptionStatus {
  subscribed
  unsubscribed
}

// Email addresses subscribed through homepage and blog newsletter forms.
model NewsletterSubscription {
  id           String                        @id @default(uuid())
  email        String                        @unique @db.VarChar(254)
  status       NewsletterSubscriptionStatus  @default(subscribed)
  source       String?                       @db.VarChar(80)
  subscribedAt DateTime                     @default(now())
  unsubscribedAt DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([status, subscribedAt])
}
